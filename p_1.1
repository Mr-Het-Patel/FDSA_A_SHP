#include <iostream>
#include <string>

using namespace std;

int main() 
{
    int size=5;
    int hours=2;
    string arr[100]={"Cake", "Donut", "Pie", "Bread", "Muffin"};

    if(cin>>size) 
    {
        for (int i=0;i<size;i++) 
        {
            cin>>arr[i];
        }
        cin>>hours;
    }

    int rotate_index=hours % size;

    for (int i=0;i<size;i++) 
    {
        int index=(i + rotate_index)%size;
        cout<<arr[index]<<" ";
    }
    return 0;
}
